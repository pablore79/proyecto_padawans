# ==========================================
# Bunker4 Alumnos - Variables de entorno
# Copiá este archivo a .env y completá los valores
# NO commitear .env (está en .gitignore)
# ==========================================

# --- App ---
APP_NAME="Bunker4 Alumnos"
APP_ENV=development          # development | staging | production
DEBUG=true

# --- Database (PostgreSQL 16) ---
# Formato: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bunker4_alumnos

# --- Security (JWT) ---
# Generar SECRET_KEY: openssl rand -hex 32
SECRET_KEY=cambiar_por_clave_secreta_segura_32_bytes_minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (ajustá según tu frontend) ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO