# ==========================================
# Bunker4 Alumnos Monorepo - Variables de entorno
# Copiá este archivo a .env y completá los valores
# NO commitear .env (está en .gitignore)
# ==========================================

# --- App ---
APP_NAME="Bunker4 Alumnos"
APP_ENV=development          # development | staging | production
DEBUG=true

# --- Database (PostgreSQL 16) - BACKEND ---
# Formato: postgresql+psycopg://user:pass@host:port/dbname
# Docker Compose: usa 'postgres' como host (nombre del servicio)
# Desarrollo local (host): usa 'localhost'
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bunker4_alumnos

# --- Tests (reset destructivo del esquema; requiere una DB dedicada) ---
# Crear esta base por separado. Su nombre DEBE terminar en `_test` y su target
# normalizado host/puerto/base DEBE ser distinto de DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bunker4_alumnos_test
# Pytest acepta solo el valor exacto `true` en minúsculas como autorización.
ALLOW_TEST_DATABASE_RESET=false

# --- Security (JWT) - Compartido entre backend y frontend ---
# Generar SECRET_KEY: openssl rand -hex 32
SECRET_KEY=cambiar_por_clave_secreta_segura_32_bytes_minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (ajustá según tu frontend) ---
# Backend: orígenes permitidos para la API (frontend URL)
# Frontend: orígenes permitidos para el BFF
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:8000"]

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend BFF ---
# URL del backend API (Docker: http://backend:8000, Local: http://localhost:8000)
BACKEND_URL=http://localhost:8000
