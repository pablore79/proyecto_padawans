# ==========================================
# Bunker4 Alumnos - Variables de entorno
# Copiá este archivo a .env y completá los valores
# NO commitear .env (está en .gitignore)
# ==========================================

# --- App ---
APP_NAME="Bunker4 Alumnos"
APP_ENV=development          # development | staging | production
DEBUG=true

# --- Database (PostgreSQL 16) ---
# Formato: postgresql+psycopg://user:pass@host:port/dbname
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bunker4_alumnos
DATABASE_URL=postgresql+psycopg://alumnos_user:ee5b544221fabada47adcd4c65128b37@10.10.153.13:5432/alumnos_db

# --- Security (JWT) ---
# Generar SECRET_KEY: openssl rand -hex 32
SECRET_KEY=6fa9856a181e81cc0c3837b375995cb6cfa0a2bb68862f65003a06363ea397ba
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (ajustá según tu frontend) ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend BFF ---
# URL del backend API (Docker: http://backend:8000, Local: http://localhost:8000)
BACKEND_URL=http://localhost:8000
